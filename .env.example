# Copy this file to .env and fill in the values. Never commit .env.

# Free Socrata app token (avoids throttling). Create one at data.sf.gov:
# sign in, then Developer Settings -> Create New App Token.
SOCRATA_APP_TOKEN=

# Used by later tasks
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SERPAPI_API_KEY=

# Optional Spark tuning
SPARK_DRIVER_MEMORY=4g
